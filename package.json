{
  "name": "@local/folia-ai-bridge",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Exposes the Harness model as an OpenAI-compatible endpoint so Folia can generate AI themes with it.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "stats.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
